{
  "name": "itachio-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "train": "tsx src/train-cli.ts",
    "backtest": "tsx --max-old-space-size=14000 src/backtest-cli.ts",
    "ingest": "tsx src/ingest-cli.ts",
    "serve:mcp": "tsx src/server.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "onnx-proto": "^8.0.1",
    "onnxruntime-node": "^1.31.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "onnx-proto": {
      "protobufjs": "^8.8.1"
    }
  }
}