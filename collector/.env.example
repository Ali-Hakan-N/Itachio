# Copy to .env and fill in. .env is never committed.

# Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# WARNING: service_role / secret key. It stays on this computer only;
# never put it in desktop/config.json or in the repo.
SUPABASE_SERVICE_ROLE_KEY=

# Which source to run (file name under src/sources/): riot | json-file
COLLECTOR_SOURCE=riot

# ---- riot source ----
# developer.riotgames.com. Development keys must be renewed every 24 hours.
RIOT_API_KEY=
# Servers, comma-separated (empty = all): na1,br1,la1,la2,euw1,eun1,tr1,ru,me1,kr,jp1,oc1,sg2,tw2,vn2
RIOT_PLATFORMS=
# Minutes spent collecting matches. Flex first, the rest goes to Solo/Duo.
# 1380 = 23 hours: uses the whole day of a development key. The run also stops
# cleanly when the key expires, and saves what it collected.
RIOT_TIME_BUDGET_MIN=1380
# Refresh scores every N minutes while running
RIOT_RESCORE_MIN=60
# How many days back to look; only the current patch counts (a match is never counted twice)
RIOT_LOOKBACK_DAYS=28
# Diamond ladder pages per division and server (205 players each)
RIOT_DIAMOND_PAGES=5
# Max new matches per region (0 = no limit)
RIOT_MAX_PER_REGION=0
# Starting rate limit "requests:seconds,...". Development key: 20:1,100:120.
# The real limit Riot reports for your key replaces it automatically.
RIOT_RATE_LIMITS=20:1,100:120

# ---- json-file source ----
COLLECTOR_FILE=./data/stats.json
