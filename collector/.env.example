# Copy to .env and fill in. .env is never committed.

# Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# WARNING: service_role / secret key. It stays on this computer only;
# never put it in desktop/config.json or in the repo.
SUPABASE_SERVICE_ROLE_KEY=

# Which source to run (file name under src/sources/): riot | json-file
COLLECTOR_SOURCE=riot

# ---- riot source ----
# developer.riotgames.com. Development keys must be renewed every 24 hours.
RIOT_API_KEY=
# Servers, comma-separated (empty = all): na1,br1,la1,la2,euw1,eun1,tr1,ru,me1,kr,jp1,oc1,sg2,tw2,vn2
RIOT_PLATFORMS=
# Minutes spent collecting matches. Flex first, the rest goes to Solo/Duo.
RIOT_TIME_BUDGET_MIN=40
# How many days back to look (a match is never counted twice)
RIOT_LOOKBACK_DAYS=7
# Max new matches per region (0 = no limit)
RIOT_MAX_PER_REGION=0
# Rate limit "requests:seconds,...". Development key: 20:1,100:120
RIOT_RATE_LIMITS=20:1,100:120

# ---- json-file source ----
COLLECTOR_FILE=./data/stats.json
