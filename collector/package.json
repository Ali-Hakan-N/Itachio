{
  "name": "flex-drafter-collector",
  "version": "0.1.0",
  "description": "Local job that collects meta, synergy and matchup data into Supabase",
  "private": true,
  "scripts": {
    "collect": "node --env-file=.env src/run.js",
    "collect:dry": "node --env-file=.env src/run.js --dry-run",
    "train": "node --env-file=.env src/train-model.js",
    "players": "node --env-file=.env src/update-players.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
