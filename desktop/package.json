{
  "name": "itachio",
  "productName": "Itachio",
  "version": "1.4.0",
  "description": "Itachio: League of Legends draft assistant for teams",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev:mock": "node test/mock-lcu.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "electron-updater": "^6.8.11",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "selfsigned": "^5.5.0"
  },
  "build": {
    "appId": "gg.itachio.app",
    "publish": [
      {
        "provider": "github",
        "owner": "Ali-Hakan-N",
        "repo": "Itachio"
      }
    ],
    "productName": "Itachio",
    "protocols": [
      {
        "name": "Itachio account recovery",
        "schemes": ["itachio"]
      }
    ],
    "files": [
      "src/**/*",
      "config.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "icon": "build/icon.png",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Itachio-Setup.exe",
      "shortcutName": "Itachio",
      "uninstallDisplayName": "Itachio",
      "guid": "300ce677-753a-5753-ad8d-df4ca459d17c"
    }
  }
}
