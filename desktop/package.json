{
  "name": "flex-drafter",
  "productName": "FlexDrafter",
  "version": "0.1.6",
  "description": "League of Legends draft assistant for teams",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev:mock": "node test/mock-lcu.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "electron-updater": "^6.8.11",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "selfsigned": "^5.5.0"
  },
  "build": {
    "appId": "gg.flexdrafter.app",
    "publish": [
      {
        "provider": "github",
        "owner": "Ali-Hakan-N",
        "repo": "lol-draft-picker"
      }
    ],
    "productName": "FlexDrafter",
    "files": [
      "src/**/*",
      "config.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "FlexDrafter-Setup.exe"
    }
  }
}
